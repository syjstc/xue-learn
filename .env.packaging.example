# Copy to .env.packaging and use existing local credentials. Never commit that file.
MACOS_SIGN_IDENTITY="Developer ID Application: YOUR NAME (TEAMID)"

# Option 1: an existing notarytool Keychain profile.
# APPLE_NOTARY_KEYCHAIN_PROFILE=your-existing-profile

# Option 2: an existing App Store Connect API key. The private key stays outside the repository.
APPLE_API_KEY=/absolute/path/AuthKey_YOURKEYID.p8
APPLE_API_KEY_ID=YOURKEYID
APPLE_API_ISSUER=YOUR-TEAM-ISSUER-UUID

# Option 3: existing Apple ID credentials (use instead of the API key fields).
# APPLE_ID=your-apple-id
# APPLE_APP_SPECIFIC_PASSWORD=your-app-specific-password
# APPLE_TEAM_ID=YOURTEAMID
