{
  "name": "@xue-learn/core",
  "version": "0.2.0",
  "description": "Reusable XueLearn learning rules, services, displays, contracts and workspace SDK",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@9.15.9",
  "main": "./dist/browser.js",
  "types": "./types/core/src/browser.d.ts",
  "files": [
    "dist",
    "types",
    "sources",
    "resources",
    "release-manifest.v1.json",
    "LICENSE",
    "LICENSING.md",
    "LICENSE-BRAND",
    "BRAND_POLICY.md",
    "BRAND_ASSETS.json",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    "./browser": {
      "types": "./types/core/src/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./display": {
      "types": "./types/core/src/display.d.ts",
      "import": "./dist/display.js",
      "default": "./dist/display.js"
    },
    "./node": {
      "types": "./types/core/src/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./workspace-client": {
      "types": "./types/core/src/workspace-client.d.ts",
      "import": "./dist/workspace-client.js",
      "default": "./dist/workspace-client.js"
    },
    ".": {
      "types": "./types/core/src/browser.d.ts",
      "import": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./display.css": "./dist/display.css",
    "./source/*": "./sources/*",
    "./package.json": "./package.json",
    "./domain": "./sources/libs/domain/src/index.ts",
    "./domain/*": "./sources/libs/domain/src/*",
    "./common": "./sources/libs/common/src/index.ts",
    "./common/*": "./sources/libs/common/src/*",
    "./server": "./sources/libs/server/src/index.ts",
    "./server/*": "./sources/libs/server/src/*",
    "./contracts": "./sources/libs/contracts/src/index.ts",
    "./contracts/*": "./sources/libs/contracts/src/*",
    "./runtime-contracts": "./sources/libs/runtime-contracts/src/index.ts",
    "./runtime-contracts/*": "./sources/libs/runtime-contracts/src/*",
    "./formula-analysis": "./sources/libs/formula-analysis/src/index.ts",
    "./formula-analysis/*": "./sources/libs/formula-analysis/src/*",
    "./formal-derivation": "./sources/libs/formal-derivation/src/index.ts",
    "./formal-derivation/*": "./sources/libs/formal-derivation/src/*",
    "./teaching-derivation": "./sources/libs/teaching-derivation/src/index.ts",
    "./teaching-derivation/*": "./sources/libs/teaching-derivation/src/*",
    "./formal-expression-core": "./sources/libs/formal-expression-core/src/index.ts",
    "./formal-expression-core/*": "./sources/libs/formal-expression-core/src/*",
    "./formal-expression-motion": "./sources/libs/formal-expression-motion/src/index.ts",
    "./formal-expression-motion/*": "./sources/libs/formal-expression-motion/src/*",
    "./lab-engine": "./sources/libs/lab-engine/src/index.ts",
    "./lab-engine/*": "./sources/libs/lab-engine/src/*",
    "./lab-protocol": "./sources/libs/lab-protocol/src/index.ts",
    "./lab-protocol/*": "./sources/libs/lab-protocol/src/*",
    "./memory": "./sources/libs/memory/src/index.ts",
    "./memory/*": "./sources/libs/memory/src/*",
    "./renderer/*": "./sources/src/*"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/verify-entries.mjs",
    "check:boundaries": "node scripts/build.mjs --check",
    "test": "jest --config jest.config.cjs --runInBand --watchman=false",
    "prepack": "pnpm run build",
    "codegen": "node scripts/codegen-contracts.mjs"
  },
  "dependencies": {
    "@astral-sh/ruff-wasm-nodejs": "0.16.0",
    "@base-ui/react": "1.5.0",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@langchain/core": "1.2.3",
    "@langchain/langgraph": "1.4.8",
    "@langchain/ollama": "1.3.0",
    "@langchain/openai": "1.5.5",
    "@langchain/textsplitters": "1.0.1",
    "@napi-rs/canvas": "0.1.80",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/platform-express": "11.1.24",
    "@resvg/resvg-js": "2.6.2",
    "@tavily/core": "0.7.5",
    "@wasm-fmt/clang-format": "20.1.7",
    "@xyflow/react": "12.11.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "elkjs": "0.11.1",
    "express": "5.2.1",
    "highlight.js": "11.11.1",
    "jsonrepair": "3.15.0",
    "katex": "0.17.0",
    "lucide-react": "1.17.0",
    "mammoth": "1.12.0",
    "marked": "18.0.5",
    "parse5": "4.0.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "2.4.5",
    "pdf-to-img": "6.2.0",
    "pdfjs-dist": "5.4.296",
    "pino": "9.14.0",
    "pino-http": "10.5.0",
    "playwright": "1.60.0",
    "prettier": "3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.17.0",
    "reflect-metadata": "0.2.2",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "rxjs": "7.8.2",
    "sharp": "0.35.1",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "ts-fsrs": "5.4.1",
    "ts-pattern": "5.9.0",
    "tslib": "2.8.1",
    "unified": "11.0.5",
    "vexflow": "4.2.5",
    "web-tree-sitter": "0.20.8",
    "word-extractor": "1.0.4",
    "zod": "4.4.3",
    "@nestjs/core": "11.1.24"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "@swc/core": "1.15.43",
    "typescript": "5.9.3",
    "jest": "29.7.0",
    "ts-jest": "29.4.11",
    "@types/node": "20.19.42",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/jest": "29.5.14",
    "@types/express": "4.17.25",
    "@types/katex": "0.16.8",
    "openapi-typescript": "7.13.0",
    "json-schema-to-typescript": "15.0.4"
  }
}
