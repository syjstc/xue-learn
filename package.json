{
  "name": "xue-learn-public",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "build:core": "pnpm --dir core run build",
    "test:core": "pnpm --dir core test",
    "check:desktop-core": "pnpm --dir desktop run check:core",
    "build:desktop": "pnpm --dir desktop run build",
    "test:desktop": "pnpm --dir desktop test",
    "check": "pnpm run build:core && pnpm run test:core && pnpm run test:desktop && pnpm --dir desktop run build:desktop-renderer && pnpm --dir desktop run local-runtime:build",
    "dev": "node scripts/dev.mjs",
    "build:mac": "pnpm --dir desktop/apps/desktop run make && node scripts/collect-mac-release.mjs",
    "check:renderer": "pnpm --dir desktop exec tsc --noEmit -p src/desktop-local/tsconfig.json",
    "check:main": "pnpm --dir desktop exec tsc --noEmit -p apps/desktop/tsconfig.json"
  }
}
