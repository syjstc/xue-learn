{
  "version": 1,
  "id": "cross-domain-chord",
  "plugins": [
    {
      "id": "example.acoustics",
      "version": "1.0.0"
    },
    {
      "id": "org.xuelearn.display.general",
      "version": "1.0.0"
    },
    {
      "id": "org.xuelearn.display.math",
      "version": "1.0.0"
    },
    {
      "id": "org.xuelearn.display.music",
      "version": "1.0.0"
    }
  ],
  "ticksPerSecond": 48000,
  "durationTicks": 576000,
  "root": {
    "id": "chord",
    "kind": "acoustics:chord-ratio",
    "version": 1,
    "payload": {
      "equations": [
        {
          "id": "ratio",
          "latex": "f_C:f_E:f_G=4:5:6",
          "label": "纯律大三和弦的频率比"
        }
      ],
      "score": {
        "type": "music",
        "version": 1,
        "id": "triad",
        "title": "三个音：依次响起与同时响起",
        "key": "C",
        "meter": "4/4",
        "tempo": 90,
        "keyboard": true,
        "notation": "both",
        "parts": [
          {
            "id": "melody",
            "label": "钢琴",
            "clef": "treble",
            "instrument": "piano",
            "bars": [
              {
                "notes": [
                  {
                    "pitches": [
                      "C4"
                    ],
                    "beats": 1
                  },
                  {
                    "pitches": [
                      "E4"
                    ],
                    "beats": 1
                  },
                  {
                    "pitches": [
                      "G4"
                    ],
                    "beats": 1
                  },
                  {
                    "pitches": [],
                    "beats": 1
                  }
                ]
              },
              {
                "notes": [
                  {
                    "pitches": [
                      "C4",
                      "E4",
                      "G4"
                    ],
                    "beats": 3
                  },
                  {
                    "pitches": [],
                    "beats": 1
                  }
                ]
              }
            ]
          }
        ],
        "steps": [
          {
            "id": "separate",
            "label": "先听三个音",
            "bars": [
              1,
              1
            ],
            "parts": [
              "melody"
            ],
            "focus": [
              "melody:1.1",
              "melody:1.2",
              "melody:1.3"
            ]
          },
          {
            "id": "together",
            "label": "同时发声",
            "bars": [
              2,
              2
            ],
            "parts": [
              "melody"
            ],
            "focus": [
              "melody:2.1"
            ],
            "compare": {
              "label": "依次发声",
              "bars": [
                1,
                1
              ],
              "parts": [
                "melody"
              ]
            }
          },
          {
            "id": "timbre",
            "label": "换音色听",
            "bars": [
              2,
              2
            ],
            "parts": [
              "melody"
            ],
            "compare": {
              "label": "管风琴",
              "bars": [
                2,
                2
              ],
              "parts": [
                "melody"
              ],
              "instruments": [
                {
                  "part": "melody",
                  "instrument": "organ"
                }
              ]
            }
          }
        ]
      }
    }
  }
}
