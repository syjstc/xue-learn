{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noCheck": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "rootDir": "sources",
    "outDir": "types"
  },
  "include": [
    "sources/**/*.ts",
    "sources/**/*.tsx"
  ],
  "exclude": [
    "sources/**/*.spec.ts",
    "sources/**/*.spec.tsx"
  ]
}
