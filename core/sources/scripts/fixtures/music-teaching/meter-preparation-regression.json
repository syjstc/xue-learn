  "cues": [
    {
      "figureId": "meter-demo",
      "text": "数音符不等于数拍子。这段明确按四分音符为一拍、每小节三拍来组织，你沿用一、二、三的稳定计数，不随音符变多而加速。",
      "targetIds": [
        "mt-group-a",
        "mt-group-b"
      ]
    },
    {
      "figureId": "meter-demo",
      "text": "先听带低音的版本：每组三拍的开头都有低音进入，旋律节奏也重复，二者共同提示分组边界。",
      "targetIds": [
        "mt-bass",
        "mt-melody"
      ],
      "music": {
        "figureId": "meter-demo",
        "clipId": "mt-supported"
      }
    },
    {
      "figureId": "meter-demo",
      "text": "第一组C占第一拍，E和F各占半拍、合起来占第二拍，G占第三拍，所以四个旋律音仍然只有三拍。",
      "targetIds": [
        "mt-group-a"
      ]
    },
    {
      "figureId": "meter-demo",
      "text": "第二组D占第一拍，F和G合占第二拍，A占第三拍；节奏模式重复，但音高换了，分组位置没有因此改变。",
      "targetIds": [
        "mt-group-b"
      ]
    },
    {
      "figureId": "meter-demo",
      "text": "按三拍子的常规节拍层级，每组第一拍是强位，第二、第三拍是弱位。这里第一组的C和第二组的D都落在强位。",
      "targetIds": [
        "mt-strong-a",
        "mt-strong-b"
      ]
    },
    {
      "figureId": "meter-demo",
      "text": "两个组内最高的旋律音G和A都落在第三拍，仍是弱位；音高最高，并没有获得强拍资格。",
      "targetIds": [
        "mt-d",
        "mt-h"
      ]
    },
    {
      "figureId": "meter-demo",
      "text": "现在去掉低音再听，继续均匀数一、二、三；第二拍内部可以默数二、与，但不要多添一拍。",
      "targetIds": [
        "mt-melody"
      ],
      "music": {
        "figureId": "meter-demo",
        "clipId": "mt-alone"
      }
    },
    {
      "figureId": "meter-demo",
      "text": "低音提示撤掉后，既定的三拍结构仍保留；强拍是一种组织位置，并不要求每次都有更响的声音替它报到。",
      "targetIds": [
        "mt-strong-a",
        "mt-strong-b"
      ]
    }
  ]
}
