{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xue-learn.local/schemas/lab-manifest.json",
  "title": "LabManifestV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "protocolVersion", "manifestVersion", "domain", "experimentId", "experimentVersion", "title", "summary", "learningIntent", "parameters", "actionIds", "scene"],
  "properties": {
    "type": { "const": "lab_manifest" },
    "protocolVersion": { "const": 1 },
    "manifestVersion": { "const": 1 },
    "domain": { "enum": ["physics", "chemistry"] },
    "experimentId": { "type": "string", "minLength": 1, "maxLength": 120 },
    "experimentVersion": { "type": "integer", "minimum": 1, "maximum": 100 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "learningIntent": { "type": "string", "minLength": 1, "maxLength": 500 },
    "targetObservation": { "type": "string", "maxLength": 500 },
    "parameters": { "type": "object", "additionalProperties": { "type": "number" } },
    "actionIds": { "type": "array", "maxItems": 40, "items": { "type": "string", "minLength": 1, "maxLength": 80 } },
    "scene": {
      "type": "object",
      "additionalProperties": true,
      "required": ["version", "components"],
      "properties": {
        "version": { "const": 1 },
        "components": { "type": "array", "minItems": 1, "maxItems": 80 },
        "vectors": { "type": "array", "maxItems": 40 },
        "trails": { "type": "array", "maxItems": 20 },
        "labels": { "type": "array", "maxItems": 80 }
      }
    }
  }
}
