{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xue-learn.local/schemas/goal.json",
  "title": "LearningGoal",
  "type": "object",
  "required": ["id", "title"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "level": { "type": "string" },
    "contentLanguage": {
      "type": "string",
      "description": "Resolved language code or auto",
      "enum": ["zh-Hans", "zh-Hant", "en", "ja", "ko", "es", "fr", "de", "other", "auto"]
    },
    "contentLanguageLabel": {
      "type": "string",
      "description": "Human-readable label for UI display"
    },
    "teachingPersonaRef": { "type": ["string", "null"] },
    "generationOptions": { "type": "string" },
    "goalKind": {
      "type": "string",
      "enum": ["full", "micro"],
      "description": "full = cognitive map course; micro = single-unit light course"
    },
    "mapPlan": { "type": "object" }
  }
}
