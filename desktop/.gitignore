# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# vite / legacy
/out/

# production / compiled output
/build
dist/
dist-admin/
.nx
.nx/cache
.swc/
test-results/
playwright-report/
blob-report/

# misc
.DS_Store
*.pem
--css
cognilearn-app-design/
__pycache__/
*.pyc
*.blend1
*.blend2

# debug
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.packaging.example

# local data
/:memory:.ses
/dev.db
/data/
/logs/
/minimax-output/

# local LLM evaluation output; commit only reviewed fixtures and baselines
/evals/runs/
/evals/output/

# vercel
.vercel

# typescript
*.tsbuildinfo
dist-desktop/
apps/desktop/dist-check/
apps/desktop/out/
apps/desktop/.forge-resources/
apps/desktop/data/
.pnpm-store/
.tools/
.expo
.codex*

# local assets/workspace
/seethrough_output*

# Godot is a local companion project; keep its editable sources/assets on disk.
# See docs/operations/local-game-and-git.md before restoring or moving it.
/apps/desktop-pixel/
/artifacts/pixel-*/
/artifacts/godot-*/
/artifacts/main-cast-cleanup/
/artifacts/course-reader-layout/
/artifacts/course-reader-compact/
/artifacts/hud-paper-v1/
/artifacts/journal-menu-v2/
/artifacts/journal-menu-v2-en/
/artifacts/course-component-redesign-v1/*.png

# generated formula-preview bundle
/artifacts/godot-formula-preview/model.cjs

# Ephemeral Electron fixture profiles contain caches and local credential stores.
/artifacts/**/electron-profile/
/artifacts/**/*-electron-profile/

# Independent product generated renderers and staging outputs.
/products/*/dist-renderer/
/products/*/.cache/

# Versioned public package staging sources (generated by package-public-libraries).
/core/sources/
/core/scripts/
/electron/client/sources/
/core/*.tgz
/electron/client/*.tgz

# License bundles copied into generated public library artifacts.
/core/LICENSE
/core/LICENSE-BRAND
/core/LICENSING.md
/core/BRAND_POLICY.md
/core/BRAND_ASSETS.json
/core/THIRD_PARTY_NOTICES.md
/electron/client/LICENSE
/electron/client/LICENSE-BRAND
/electron/client/LICENSING.md
/electron/client/BRAND_POLICY.md
/electron/client/BRAND_ASSETS.json
/electron/client/THIRD_PARTY_NOTICES.md

/build-receipts/
/coverage/
