{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "jest"],
    "noEmit": true
  },
  "include": ["./**/*.ts", "./**/*.tsx", "../vite-env.d.ts"],
  "exclude": ["./**/*.spec.ts", "./**/*.spec.tsx"]
}
