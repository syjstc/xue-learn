{
  "name": "@xue-learn/desktop",
  "version": "0.3.2",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "test:public": "pnpm run check:core && jest --config jest.config.cjs --runInBand --watchman=false",
    "build:lab": "vite build --config apps/lab-runtime/vite.config.ts",
    "build:desktop-renderer": "vite build --config vite.desktop-local.config.ts",
    "local-runtime:build": "node scripts/build-service.mjs local-runtime",
    "local-runtime:build:prod": "node scripts/build-service.mjs local-runtime --production",
    "desktop:build": "pnpm run check:core && pnpm run build:lab && pnpm run build:desktop-renderer && LAB_RUNTIME_TARGET=dist-desktop node scripts/copy-lab-runtime.mjs && pnpm run local-runtime:build:prod && pnpm --dir apps/desktop build:release",
    "desktop:dev": "node ../scripts/dev.mjs",
    "desktop:stop": "node scripts/desktop-dev-clean.mjs --stop-only",
    "desktop:clean": "node scripts/desktop-dev-clean.mjs",
    "desktop:restart": "pnpm run desktop:clean && pnpm run desktop:dev",
    "test:desktop-dev": "node --test scripts/desktop-dev.test.mjs scripts/desktop-dev-preflight.test.mjs scripts/desktop-dev-clean.test.mjs",
    "check:persistence-schema": "node scripts/check-persistence-schema-fingerprint.mjs --check",
    "check:core": "pnpm --dir ../core run build && node scripts/check-core-dependency.mjs",
    "test": "pnpm run check:core && jest --config jest.config.cjs --runInBand --watchman=false",
    "build": "pnpm run desktop:build",
    "dev": "pnpm run desktop:dev",
    "build:plugin-sdk": "node scripts/build-plugin-sdk.mjs",
    "build:example-plugin": "node scripts/build-example-plugin.mjs",
    "test:plugins": "pnpm run check:core && jest --config jest.config.cjs --runInBand --watchman=false packages/plugin-sdk/src apps/desktop/src/plugins src/features/plugins src/desktop-local/local-embedding-setup-gate.spec.tsx apps/desktop/src/packaged-resource-audit.spec.ts",
    "verify:plugins": "node scripts/verify-desktop-plugins.mjs",
    "verify:plugin-ui": "node scripts/verify-plugin-ui.mjs"
  },
